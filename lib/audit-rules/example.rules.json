{
  // ============================================================
  // 审计规则包【自定义空示例】（v1.42.0）——复制本文件改造为自己的规则包
  // ============================================================
  //
  // 用法（三选一，配在 DSH 插件配置 auditRuleset 键，或 code_audit 工具 ruleset 参数）：
  //   1) 本地文件：  "auditRuleset": "/绝对路径/your.rules.json"
  //   2) 在线包：    "auditRuleset": "https://example.com/your.rules.json"   （8s 超时，2MB 上限，启动后热替换）
  //   3) 内置包：    "auditRuleset": "builtin"   （= lib/audit-rules/eightfs.rules.json，归属 EIGHTfs）
  //
  // 语义（整包替换）：配置生效后，规则包完全取代内置包——rules 里没写的检查就不会跑。
  //   想在 EIGHTfs 规则基础上加规则：复制 eightfs.rules.json 全量规则再追加。
  //
  // 格式说明：
  //   name/owner/version  —— 必填；owner 是规则归属方（审计溯源 ruleset.owner 输出）
  //   rules[]             —— 必填且至少 1 条（空数组校验不通过）；id 必须唯一
  //   kind 取值：
  //     secret            —— 新增行敏感信息正则（blocker）；.json 内 // 注释行自动豁免（隐私入库类豁免）
  //     credential-file   —— 凭据文件路径匹配（pathPattern，blocker）；同上豁免
  //     credential-ref    —— 文档里凭据引用/明文（warning）；同上豁免
  //     comment-wording   —— 代码注释措辞（blocker，只查注释行）；json 注释行【不】豁免
  //     doc-conversation  —— 文档对话类措辞（blocker，只查 md/txt）；json 注释行【不】豁免
  //     code-quality      —— 质量阈值/正则（threshold/blockThreshold/min/max/pattern）
  //   level               —— "blocker"（拦截）| "warning"（提醒）
  //   pattern/pathPattern —— JS 正则源码字符串；装载时校验可编译，非法整包拒绝
  //   message             —— 可选；命中时输出给 AI 的提示文案（secret/credential-ref 建议写）
  //
  // 豁免约定（用户确立，不改可跳过）：
  //   .json 文件内 // 注释行豁免「隐私入库类」（secret/credential-file/credential-ref）；
  //   comment-wording / doc-conversation / 代码质量不豁免——豁免只是豁免隐私入库。
  //   另有通用豁免：行内/文件头 dsh-skip-sensitive 标记（跳过敏感内容类规则）、示例词整行、占位符值。
  //
  // 本示例只含 1 条永不匹配的占位规则（pattern 写成你自己想拦的正则即生效）。
  // ============================================================
  "name": "my-pack",
  "owner": "你的名字",
  "version": "0.0.1",
  "description": "自定义规则包空示例：把 rules 换成自己的规则；整包替换语义，没写的检查不会跑",

  "rules": [
    {
      "id": "my-first-secret-rule",
      "kind": "secret",
      "level": "blocker",
      "name": "示例：拦截自定义 token",
      "pattern": "\\bmytoken_[A-Za-z0-9]{20,}\\b",
      "message": "发现 mytoken_ 前缀令牌硬编码，请改为配置注入"
    }
    // 再加一条措辞规则（只查代码注释行）：
    // { "id": "no-boss-words", "kind": "comment-wording", "level": "blocker", "name": "老板说", "pattern": "老板(说|要求|拍板)" }
    //
    // 再加一条文档对话规则（只查 md/txt 新增行）：
    // { "id": "no-meeting-notes", "kind": "doc-conversation", "level": "blocker", "name": "会议记录", "pattern": "(会议纪要|评审结论)" }
    //
    // 再加一条质量阈值（函数行数）：
    // { "id": "func-lines", "kind": "code-quality", "level": "warning", "threshold": 80, "blockThreshold": 150 }
  ],

  // 质量阈值（可缺省，缺省 50/100）：与 rules 里 code-quality 的 func-lines 条目二选一或同用
  "quality": {
    "funcLinesWarn": 50,
    "funcLinesBlock": 100,
    // v1.42.0：文件级评分（scoreFile）阈值——行数基准 200 / 容量基准 30KB，斜率与扣分上限见内置默认
    "fileLinesBase": 200,
    "fileKbBase": 30
  }
}
