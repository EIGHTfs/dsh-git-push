{
  "name": "dsh-git-push",
  "version": "1.20.0",
  "description": "git 自动提交推送 + 代码审计门禁：设置页填 GitHub token；推送后回传远端最近 3 次 SHA/标题/时间。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "skills": [
      "./skills/dsh-git-push.md",
      "./skills/task-completion-report.md"
    ],
    "description": "开发者要求与本机凭据在同级私有仓 dsh-git-push-User（api.github.com clone 到工作区同一层级，不进插件目录）。"
  }
}