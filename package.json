{
  "name": "dsh-git-push",
  "version": "3.1.1",
  "description": "DSH git 自动提交推送插件——统一函数入口架构（规则/审计/git/自身/侧边栏/评分/豁免/上下文/HTTP/测试十大总入口）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "git-sluice": "./cli.mjs",
    "tool-sluice": "./cli-tool.mjs"
  },
  "files": [
    "lib",
    "skills",
    "scripts/scan-repos.mjs",
    "cli.mjs",
    "cli-tool.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "audit-sluice": "0.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepare": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node test/run-tests.mjs",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "commit",
    "push",
    "audit",
    "cli"
  ],
  "author": "EIGHTfs",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "skills": [
      "./skills/dsh-repo-index.md",
      "./skills/dev/dsh-git-push.md",
      "./skills/dev/git-push-live-fix.md",
      "./skills/guide/guide-cli-scripts.md",
      "./skills/guide/guide-clone-repos.md",
      "./skills/guide/guide-commit-push.md",
      "./skills/guide/guide-inject-ui.md",
      "./skills/guide/guide-slash-completion.md",
      "./skills/workflow/README.md",
      "./skills/workflow/git-commit-discipline.md",
      "./skills/workflow/git-project-startup.md",
      "./skills/workflow/git-rebuild-process.md",
      "./skills/workflow/github-operations.md",
      "./skills/workflow/readme-sync-git-md.md",
      "./skills/workflow/task-completion-report.md",
      "./skills/workflow/tool-json-add-ask.md",
      "./skills/workflow/versioning-rule.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/dsh-git-push.git"
  },
  "bugs": {
    "url": "https://github.com/EIGHTfs/dsh-git-push/issues"
  },
  "homepage": "https://github.com/EIGHTfs/dsh-git-push#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0-0"
  },
  "dshScopeCheck": {
    "note": "拼接产物作用域检查：files 里每个文件都查「同作用域重名 / 顶层声明 / 命名前缀」。查法：git-sluice scope-check（无参数即读本块 files）；其它项目只要在自己的 package.json 写同名字段即可复用同一套判定",
    "files": [
      "lib/client.js"
    ],
    "prefix": "dshgp_",
    "allowlist": [
      "module",
      "exports",
      "jsx",
      "react",
      "store",
      "NS",
      "SETTINGS_NS",
      "inject",
      "apply"
    ],
    "topLevelMustBeEmpty": true
  }
}
